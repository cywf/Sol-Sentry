---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL || '/Sol-Sentry';
const breadcrumbs = [{ name: 'Visualizer', href: `${baseUrl}/visualizer` }];
---

<Layout title="Project Visualizer" breadcrumbs={breadcrumbs}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-4">Project Visualizer</h1>
    <p class="text-lg opacity-80">
      Interactive Mermaid diagrams visualizing project architecture and workflows.
    </p>
  </div>

  <div id="visualizer-root"></div>

  <script>
    import { createElement } from 'react';
    import { createRoot } from 'react-dom/client';
    import MermaidViewer from '../components/MermaidViewer';

    const container = document.getElementById('visualizer-root');
    if (container) {
      const root = createRoot(container);
      root.render(createElement(MermaidViewer));
    }
  </script>
</Layout>
