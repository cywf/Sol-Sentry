---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL || '/Sol-Sentry';
---

<Layout title="404 - Page Not Found">
  <div class="hero min-h-[70vh]">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-9xl font-bold text-primary">404</h1>
        <h2 class="text-3xl font-bold mt-4">Page Not Found</h2>
        <p class="py-6">
          Sorry, the page you're looking for doesn't exist or has been moved.
        </p>
        <div class="flex flex-col gap-2">
          <a href={`${baseUrl}/`} class="btn btn-primary">
            Go Home
          </a>
          <a href={`${baseUrl}/audit-explorer`} class="btn btn-ghost">
            Audit Explorer
          </a>
          <a href={`${baseUrl}/docs`} class="btn btn-ghost">
            Documentation
          </a>
          <a href={`${baseUrl}/app`} class="btn btn-ghost">
            Streamlit App
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
