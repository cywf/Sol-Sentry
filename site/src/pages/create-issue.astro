---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL || '/Sol-Sentry';
const breadcrumbs = [{ name: 'Create Issue', href: `${baseUrl}/create-issue` }];
---

<Layout title="Create Issue" breadcrumbs={breadcrumbs}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-4">Create Issue</h1>
    <p class="text-lg opacity-80">
      Report a bug, request a feature, or suggest documentation improvements.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Bug Report -->
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-error">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Bug Report
        </h2>
        <p>Report a bug or issue with Sol-Sentry.</p>
        <div class="card-actions justify-end">
          <a
            href="https://github.com/cywf/Sol-Sentry/issues/new?template=bug_report.md&labels=bug&title=%5BBUG%5D%3A+"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-error btn-sm"
          >
            Report Bug
          </a>
        </div>
      </div>
    </div>

    <!-- Feature Request -->
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-success">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Feature Request
        </h2>
        <p>Suggest a new feature or enhancement.</p>
        <div class="card-actions justify-end">
          <a
            href="https://github.com/cywf/Sol-Sentry/issues/new?template=feature_request.md&labels=enhancement&title=%5BFEATURE%5D%3A+"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-success btn-sm"
          >
            Request Feature
          </a>
        </div>
      </div>
    </div>

    <!-- Documentation -->
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-info">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Documentation
        </h2>
        <p>Improve or request documentation updates.</p>
        <div class="card-actions justify-end">
          <a
            href="https://github.com/cywf/Sol-Sentry/issues/new?labels=documentation&title=%5BDOCS%5D%3A+"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-info btn-sm"
          >
            Suggest Docs
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- General Issue Button -->
  <div class="mt-8 text-center">
    <a
      href="https://github.com/cywf/Sol-Sentry/issues/new/choose"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary btn-wide"
    >
      Or Choose From All Templates
    </a>
  </div>

  <!-- Existing Issues Link -->
  <div class="mt-8 alert alert-info">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <span>
      Before creating a new issue, please check
      <a href="https://github.com/cywf/Sol-Sentry/issues" target="_blank" rel="noopener noreferrer" class="link link-hover font-bold">
        existing issues
      </a>
      to avoid duplicates.
    </span>
  </div>
</Layout>
